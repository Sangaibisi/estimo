# Template for a LOCAL DEMO / development: cp .env.dev.example .env
#
# The difference from .env.example is one thing — the gateway points at the STUB LLM
# that ships in this repo, so nothing external is needed and no tokens are spent. The
# stub returns fixed, obviously-synthetic completions: it exercises the wiring, it does
# NOT produce estimates anyone should read.
#
#   docker compose --profile mock up --build -d
#
# The `mock` profile is what starts that container. Without it the gateway below points
# at a host that is not running.
#
# Never use this file for a real deployment.

# --- docker compose: database bootstrap ---
POSTGRES_USER=estimo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=estimo

ESTIMO_DATABASE_URL=postgresql+asyncpg://estimo:change-me@db:5432/estimo
ESTIMO_LOG_LEVEL=INFO

# --- the stub LLM (compose profile `mock`) ---
ESTIMO_GATEWAY__BASE_URL=http://mock-llm:8080/v1
ESTIMO_GATEWAY__API_KEY=sk-local-dev
ESTIMO_GATEWAY__MAX_RETRIES=2
ESTIMO_GATEWAY__TIMEOUT_SECONDS=120
ESTIMO_GATEWAY__CONNECT_TIMEOUT_SECONDS=5
ESTIMO_GATEWAY__PROFILES={"default": "mock-small", "smoke": "mock-small"}
