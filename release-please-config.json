{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "refactor", "section": "Changed" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "revert", "section": "Reverted" }
      ],
      "extra-files": [
        { "type": "toml", "path": "apps/api/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "packages/core/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "packages/gateway/pyproject.toml", "jsonpath": "$.project.version" }
      ]
    }
  }
}
