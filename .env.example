# Copy to .env for local development. Containers receive config ONLY via environment
# (ADR-0006); nothing here is baked into images. Never commit .env.

# --- docker compose: database bootstrap ---
POSTGRES_USER=estimo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=estimo

# --- application (pydantic-settings, prefix ESTIMO_, nested via __) ---
# In compose the api reaches the db service by name; on the host use localhost.
ESTIMO_DATABASE_URL=postgresql+asyncpg://estimo:change-me@db:5432/estimo
ESTIMO_LOG_LEVEL=INFO
# Browser origins allowed to call the API (JSON list). Defaults cover local dev.
#ESTIMO_CORS_ORIGINS=["http://localhost:3000"]

# --- web (compose `web` service) ---
# Origin the BROWSER uses to reach the API; injected at runtime, never baked.
#ESTIMO_WEB_API_URL=http://localhost:8000

# --- LLM gateway (OpenAI-compatible endpoint; LiteLLM in real deployments, ADR-0001) ---
ESTIMO_GATEWAY__BASE_URL=http://mock-llm:8080/v1
ESTIMO_GATEWAY__API_KEY=sk-local-dev
ESTIMO_GATEWAY__MAX_RETRIES=2
ESTIMO_GATEWAY__TIMEOUT_SECONDS=120
ESTIMO_GATEWAY__CONNECT_TIMEOUT_SECONDS=5
# Stage -> model routing profiles as ONE JSON value (dict fields take JSON, not nested vars)
ESTIMO_GATEWAY__PROFILES={"default": "mock-small", "smoke": "mock-small"}

# --- observability (OPT-IN, S8-4): `docker compose --profile observability up` ---
# The api forwards telemetry to Langfuse ONLY when the two keys below are set;
# unset = complete no-op. Keys must match the LANGFUSE_INIT_PROJECT_* values the
# profile provisions (defaults align out of the box). Honest cost note: the Langfuse
# stack (web+worker+postgres+clickhouse+redis+minio) wants ~4 cores / 16 GiB upstream.
#LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
#LANGFUSE_SECRET_KEY=sk-lf-local-dev
#LANGFUSE_HOST=http://langfuse-web:3000
# Profile secrets (all CHANGEME for anything beyond a laptop):
#LANGFUSE_NEXTAUTH_SECRET=change-me
#LANGFUSE_DB_PASSWORD=change-me
#LANGFUSE_CLICKHOUSE_PASSWORD=change-me
#LANGFUSE_REDIS_PASSWORD=change-me
#LANGFUSE_MINIO_PASSWORD=change-me
#LANGFUSE_INIT_USER_EMAIL=admin@estimo.local
#LANGFUSE_INIT_USER_PASSWORD=change-me-password
